# Copy to oauth.env to bake OAuth credentials into the build, so the app never
# asks for a client ID on any device.
#
#   cp oauth.env.example oauth.env      # then fill in and rebuild
#
# oauth.env is gitignored. Every provider is optional — fill in only the ones
# you use. Leave the file out entirely and the app simply asks once, storing
# what you enter (which then travels to your other devices in the encrypted
# bundle).
#
# Register this redirect URI with every provider, exactly:
#
#   http://127.0.0.1:8787/oauth/callback
#
# Providers needing NO registration at all: pCloud (email + password),
# WebDAV (Yandex Disk, Nextcloud, Koofr, Box, NAS), S3 (access keys).

# --- Google Drive ---------------------------------------------------------
# console.cloud.google.com/apis/credentials
#  1. Create a project, then enable the "Google Drive API"
#  2. Configure the OAuth consent screen (External, add yourself as a test
#     user — an unpublished app is fine for personal use)
#  3. Credentials -> Create credentials -> OAuth client ID
#     Application type: DESKTOP APP
#
# Choose "Desktop app", not "Web application". Google accepts loopback
# redirects (http://127.0.0.1:ANY_PORT/oauth/callback) for desktop clients
# without registering them, so there is nothing to mistype and nothing to
# break if the port ever changes.
#
# If you already made a "Web application" client, it still works — but you
# must add this exact URI under Authorised redirect URIs, or you get
# "Error 400: redirect_uri_mismatch":
#
#   http://127.0.0.1:8787/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OneDrive -------------------------------------------------------------
# entra.microsoft.com -> App registrations -> New registration
#  Supported account types: personal Microsoft accounts included
#  Redirect URI: platform "Web", http://127.0.0.1:8787/oauth/callback
#  A secret is optional if you register it as a public client.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# --- Dropbox --------------------------------------------------------------
# dropbox.com/developers/apps -> Create app -> Scoped access -> Full Dropbox
#  Permissions tab, tick: account_info.read, files.metadata.read,
#  files.metadata.write, files.content.read, files.content.write
#  Settings tab, OAuth 2 redirect URI: http://127.0.0.1:8787/oauth/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
