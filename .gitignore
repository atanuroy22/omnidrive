.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Go
*.test
*.out
vendor/

# Sensitive OAuth client secrets (auto-generated from console.cloud.google.com etc.)
client_secret_*.json

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
base_src
