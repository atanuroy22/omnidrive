# Local state — contains encrypted account credentials
.omnidrive/
*.omnibundle
-port/

# APK build
android/.build/
# Signing key: a private key, so it must not be committed — but back it up.
# Android refuses to upgrade an app signed with a different key.
android/*.keystore

# Compiled-in OAuth client credentials
oauth.env

